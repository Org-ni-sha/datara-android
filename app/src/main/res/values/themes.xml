<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.DATAra" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/datara_launch_background</item>
        <item name="android:statusBarColor">@color/datara_launch_background</item>
        <item name="android:navigationBarColor">@color/datara_launch_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.DATAra.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/datara_launch_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/datara_splash_symbol</item>
        <item name="postSplashScreenTheme">@style/Theme.DATAra</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
