    <!-- Privacy and terms -->
    <string name="privacy_eyebrow">PRIVACY</string>
    <string name="privacy_title">Privacy and data collection</string>
    <string name="privacy_subtitle">A plain-language summary of what DATAra is designed to measure and why.</string>
    <string name="privacy_draft_badge">Project information</string>
    <string name="privacy_measure_title">What DATAra measures</string>
    <string name="privacy_measure_body">DATAra is designed to measure device-level mobile-data consumption, usage time patterns, signal strength, transfer speed, active promo details, and prediction results.</string>
    <string name="privacy_not_collect_title">What DATAra does not need</string>
    <string name="privacy_not_collect_body">The app does not need to read SMS content, contacts, precise location, addresses, or unrelated personal messages. Email remains the sign-in identifier.</string>
    <string name="privacy_local_title">Local-first processing</string>
    <string name="privacy_local_body">Usage records and PET inference are planned to operate on the device first. The current frontend has no telemetry database or ML runtime connected.</string>
    <string name="privacy_sync_title">Future synchronization</string>
    <string name="privacy_sync_body">A later phase may synchronize authorized records to the DATAra backend. Cloud synchronization is not active in this frontend build, and the UI labels it as unavailable.</string>
    <string name="privacy_accuracy_title">Carrier accounting can differ</string>
    <string name="privacy_accuracy_body">Device counters cannot perfectly reproduce carrier billing. Zero-rated apps, promo inclusions, network overhead, and carrier rounding can produce different totals.</string>
    <string name="privacy_control_title">User control</string>
    <string name="privacy_control_body">Usage and notification access should be explained before Android settings are opened. Users should be able to decline and review access later.</string>
    <string name="privacy_footer">This capstone-project summary is not a final production privacy policy.</string>

    <string name="terms_eyebrow">TERMS</string>
    <string name="terms_title">Terms and responsible use</string>
    <string name="terms_subtitle">The expectations and limitations of the DATAra capstone application.</string>
    <string name="terms_draft_badge">Project draft</string>
    <string name="terms_purpose_title">Intended purpose</string>
    <string name="terms_purpose_body">DATAra helps prepaid mobile users understand device-measured consumption and estimate when an active data promo may be exhausted.</string>
    <string name="terms_estimate_title">Predictions and balances are estimates</string>
    <string name="terms_estimate_body">PET values and remaining balances are decision-support estimates. Users should confirm official balances, expiry dates, and purchases with their carrier.</string>
    <string name="terms_carrier_title">No carrier affiliation</string>
    <string name="terms_carrier_body">Sample Smart, Globe, and DITO promo information is used for interface demonstration only. DATAra does not represent or replace a mobile carrier.</string>
    <string name="terms_access_title">Responsible access</string>
    <string name="terms_access_body">Users should grant only the Android access they understand. DATAra must explain usage tracking and visible background-service behavior before requesting access.</string>
    <string name="terms_availability_title">Capstone availability</string>
    <string name="terms_availability_body">Features can be unavailable while telemetry, synchronization, notifications, or machine-learning components are still under development.</string>
    <string name="terms_footer">These project terms are a frontend draft and require formal review before production release.</string>

