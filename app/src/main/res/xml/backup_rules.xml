<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules for Android 11 and lower (Android 12+ uses data_extraction_rules.xml).
   See https://developer.android.com/guide/topics/data/autobackup

   The local database and this install's device ids are never backed up: restoring them on
   another phone would reuse this phone's device_id and telemetry checkpoints. Synced data comes
   back from Supabase instead.
-->
<full-backup-content>
    <exclude domain="database" path="datara.db" />
    <exclude domain="database" path="datara.db-shm" />
    <exclude domain="database" path="datara.db-wal" />
    <exclude domain="sharedpref" path="datara_device.xml" />
</full-backup-content>
