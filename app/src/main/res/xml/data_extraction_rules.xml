<?xml version="1.0" encoding="utf-8"?><!--
   Backup and device-transfer rules for Android 12 and higher.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes

   The local database and this install's device ids stay on this phone (see backup_rules.xml).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="datara.db" />
        <exclude domain="database" path="datara.db-shm" />
        <exclude domain="database" path="datara.db-wal" />
        <exclude domain="sharedpref" path="datara_device.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="datara.db" />
        <exclude domain="database" path="datara.db-shm" />
        <exclude domain="database" path="datara.db-wal" />
        <exclude domain="sharedpref" path="datara_device.xml" />
    </device-transfer>
</data-extraction-rules>
